{# TESTAHLEEN footer (v3) — restrained ivory, single-language, accordion on mobile.
   All dynamic/mandatory blocks preserved: menu, contacts, social, apps,
   payments, trust badges, tax/verification, copyright hook. #}
<footer class="store-footer">
  <div aria-label="footer" class="store-footer__inner">
    <div class="container" style="max-width:1440px">
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 lg:gap-10 py-2">

        <div class="lg:col-span-1">
          <a href="{{ link('/') }}" class="inline-block m-0">
            <span class="tsx-foot-brand">{{ language.code == 'en' ? 'TESTAHLEEN' : 'تستاهلين' }}</span>
          </a>
          <p class="tsx-foot-desc">{{ trans('tsx.footer_desc') }}</p>
          <div class="mt-5">
            <salla-social class="block"></salla-social>
          </div>
        </div>

        <details open>
          <summary>{{ trans('blocks.footer.pages_links') }}</summary>
          <salla-menu source="footer" with-cookie-preferences></salla-menu>
        </details>

        <details open>
          <summary>{{ trans('tsx.footer_contact') }}</summary>
          <salla-contacts></salla-contacts>
        </details>

        <details open>
          <summary>{{ trans('tsx.footer_apps') }}</summary>
          <salla-apps-icons></salla-apps-icons>
          <div class="flex items-end gap-4 mt-4 flex-wrap">
            <salla-trust-badges></salla-trust-badges>
            {% if store.settings.tax.number %}
              <div class="flex rtl:space-x-reverse space-x-2 items-end">
                {% if store.settings.tax.certificate %}
                  <a class="load-img-onclick" data-modal-id="modal-value-tax" href="#/" alt="{{ store.settings.tax.number }}">
                    <img width="40" height="50" src="{{ 'images/tax.png' | cdn(70,70) }}" loading="lazy" class="w-10" alt="value added tax">
                  </a>
                {% endif %}
                <div>
                  <p class="text-sm mb-1">{{ trans('common.elements.tax_number') }}</p>
                  <b class="text-sm">{{ store.settings.tax.number }}</b>
                </div>
              </div>
              {% if store.settings.tax.certificate %}
                <salla-modal sub-title-first sub-title="{{ trans('common.elements.tax_number') }}" modal-title="{{ store.settings.tax.number }}" id="modal-value-tax">
                  <div class="flex justify-center max-w-full">
                    <img class="w-full" loading="lazy" data-src="{{ store.settings.tax.certificate }}" alt="{{ store.settings.tax.number }}"/>
                  </div>
                </salla-modal>
              {% endif %}
            {% endif %}
          </div>
        </details>

      </div>

      <div class="tsx-foot-base pb-6">
        <span class="copyright-text">{% hook copyright %}</span>
        <salla-payments></salla-payments>
      </div>
    </div>
  </div>
</footer>
<script>
  /* mobile: collapse footer accordions by default; desktop keeps them open */
  (function () {
    if (window.matchMedia('(max-width: 1023.98px)').matches) {
      document.querySelectorAll('.store-footer details[open]').forEach(function (d) { d.removeAttribute('open'); });
    }
  })();
</script>
