{#
  TESTAHLEEN header (v3) — announcement ribbon + one clean navigation row.
  Wordmark is typographic (editorial font). Search = compact modal trigger.
  Language action is the native locale link: `العربية` on EN, `EN` on AR.
#}
{% set is_en = language.code == 'en' %}
{% set alt_locale_url = is_en ? (store.url ~ '/ar') : (store.url ~ '/en') %}
<header class="store-header">
  {# announcement / utility ribbon #}
  <div class="top-navbar">
    <div class="container flex items-center justify-between w-full">
      <a class="tsx-lang-link" data-tsx-lang="{{ is_en ? 'ar' : 'en' }}" href="{{ alt_locale_url }}">
        {{ is_en ? 'العربية' : 'EN' }}
      </a>
      <span class="tsx-desktop-only">{{ trans('tsx.announcement') }}</span>
      <span class="tsx-desktop-only">
        {% if store.contacts.email %}{{ store.contacts.email }}{% endif %}
      </span>
    </div>
  </div>

  {# main row #}
  <div id="mainnav" class="main-nav-container flex items-center">
      <div class="inner bg-inherit w-full">
          <div class="container">
              <div class="flex items-center justify-between relative">
                  <div class="flex items-center min-w-0">
                      <a class="lg:hidden mburger mburger--collapse leading-none rtl:ml-2 ltr:mr-2" href="#mobile-menu" aria-label="Open-menu">
                        <i class="sicon-menu text-2xl"></i>
                      </a>
                      <a class="navbar-brand" href="{{ store.url }}">
                          <img fetchpriority="high" width="100%" height="100%" loading="eager" src="{{ store.logo|cdn(175) }}" alt="{{ store.name }} logo">
                          <span class="tsx-wordmark" aria-hidden="true">{{ is_en ? 'TESTAHLEEN' : 'تستاهلين' }}</span>
                          {% if is_page('index') %}
                            <h1 class="sr-only">{{ store.name }}</h1>
                          {% else %}
                            <h2 class="sr-only">{{ store.name }}</h2>
                          {% endif %}
                      </a>
                      <custom-main-menu></custom-main-menu>
                  </div>
                  <div class="flex items-center justify-end">
                      <salla-search class="header-search-mobile" placeholder height="38"></salla-search>
                      <salla-user-menu avatar-only show-header show-trigger></salla-user-menu>
                      <salla-cart-summary class="rtl:mr-1 ltr:ml-1">
                        <i slot="icon" class="header-btn__icon icon sicon-shopping-bag"></i>
                      </salla-cart-summary>
                  </div>
              </div>
          </div>
      </div>
  </div>
</header>
<script>
  /* persist the customer's explicit language choice (native locale links do the switch) */
  document.addEventListener('click', function (e) {
    var l = e.target.closest('[data-tsx-lang]');
    if (l) { try { localStorage.setItem('tsx-lang', l.getAttribute('data-tsx-lang')); } catch (err) {} }
  });
</script>
