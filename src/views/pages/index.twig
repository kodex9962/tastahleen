{#
  TESTAHLEEN — continuous editorial homepage (v3, locale-pure).
  hero film → 4 products → film → 4 products → film → 4 products → packaging film.
  Three dynamic latest-12 lists; CSS banding 1-4/5-8/9-12 (.band-1/2/3).
  No category dependency, no hard-coded product data. Copy via locale files only.
#}
{% extends "layouts.master" %}

{% block content %}
<div class="ts-home">

  <section class="hero" id="hero" aria-label="{{ store.name }}">
    <video class="hero-video" autoplay muted loop playsinline preload="metadata" aria-hidden="true"
           poster="{{ 'images/tastahleen/video/hero-poster.jpg' | asset }}">
      <source src="{{ 'images/tastahleen/video/hero.mp4' | asset }}" type="video/mp4" />
    </video>
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-copy">
      <h1 class="hero-title">
        <span class="line hero-brand">{{ language.code == 'en' ? 'TESTAHLEEN' : 'تستاهلين' }}</span>
        <span class="line hero-sub">{{ trans('tsx.hero_tagline') }}</span>
      </h1>
      <div class="hero-ctas">
        <a class="btn-hero" href="#edit-1">{{ trans('tsx.shop_now') }}</a>
      </div>
    </div>
  </section>

  <section class="edit-band band-1 reveal" id="edit-1" aria-label="{{ trans('tsx.products_band') }}">
    <div class="edit-flow ts-salla-grid">
      <salla-products-list source="latest" limit="12"></salla-products-list>
    </div>
  </section>

  <section class="moment reveal" aria-label="{{ store.name }}">
    <video autoplay muted loop playsinline preload="metadata" aria-hidden="true"
           poster="{{ 'images/tastahleen/video/campaign-poster.jpg' | asset }}">
      <source src="{{ 'images/tastahleen/video/campaign.mp4' | asset }}" type="video/mp4" />
    </video>
    <div class="moment-caption"><p>{{ trans('tsx.caption_campaign') }}</p></div>
  </section>

  <section class="edit-band band-2 reveal" id="edit-2" aria-label="{{ trans('tsx.products_band') }}">
    <div class="edit-flow ts-salla-grid">
      <salla-products-list source="latest" limit="12"></salla-products-list>
    </div>
  </section>

  <section class="moment reveal" aria-label="{{ store.name }}">
    <video autoplay muted loop playsinline preload="metadata" aria-hidden="true"
           poster="{{ 'images/tastahleen/video/garment-poster.jpg' | asset }}">
      <source src="{{ 'images/tastahleen/video/garment.mp4' | asset }}" type="video/mp4" />
    </video>
    <div class="moment-caption"><p>{{ trans('tsx.caption_garment') }}</p></div>
  </section>

  <section class="edit-band band-3 reveal" id="edit-3" aria-label="{{ trans('tsx.products_band') }}">
    <div class="edit-flow ts-salla-grid">
      <salla-products-list source="latest" limit="12"></salla-products-list>
    </div>
  </section>

  <section class="moment moment-packaging reveal" aria-label="{{ trans('tsx.caption_packaging') }}">
    <video autoplay muted loop playsinline preload="metadata" aria-hidden="true"
           poster="{{ 'images/tastahleen/video/packaging-poster.jpg' | asset }}">
      <source src="{{ 'images/tastahleen/video/packaging.mp4' | asset }}" type="video/mp4" />
    </video>
    <div class="moment-caption"><p>{{ trans('tsx.caption_packaging') }}</p></div>
  </section>

</div>
{% endblock %}

{% block scripts %}
    <script defer src="{{ 'home.js' | asset }}"></script>
{% endblock %}
